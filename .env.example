# Copy this file to ".env" and fill in the values. Never commit ".env" and never put it in public/.

# Port the website and API run on (http://localhost:3000)
PORT=3000

# --- Admin account -----------------------------------------------------------------------------
# The admin dashboard login. The account is created automatically on first start.
ADMIN_EMAIL=karamne99@gmail.com
# Hash of the admin password (NOT the password). Create one with:
#     npm run hash-password -- "your password here"
# then paste the printed line here. Changing it here and restarting updates the admin password.
ADMIN_PASSWORD_HASH=

# --- Sessions ----------------------------------------------------------------------------------
# Long random text, at least 32 characters. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# --- Email notifications (sent to ADMIN_EMAIL whenever a team registers) -------------------------
# Gmail example: host smtp.gmail.com, port 465 (or 587), your Gmail address, and an App Password.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password-or-app-password
# Optional: the "From" address (defaults to EMAIL_USER)
# EMAIL_FROM=NASA Space Apps Madaba <your-email@example.com>

# --- Optional -----------------------------------------------------------------------------------
# Set to true when the site is served over HTTPS (real hosting) so the login cookie is marked Secure.
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy so client IP addresses are read correctly.
# TRUST_PROXY=true
# Where the SQLite database file is stored (default: database/space_apps.db).
# On a hosting service, point this at the persistent disk / volume, for example:
# DATABASE_PATH=/var/data/space_apps.db
